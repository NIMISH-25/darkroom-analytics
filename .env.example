# =============================================================================
# (A) HOW TO USE
# =============================================================================
# The backend reads `.env` from the folder it is started in.
#   - Backend variables:  cp .env.example backend/.env
#   - Frontend variables: copy the NEXT_PUBLIC_ lines into frontend/.env.local
# Never commit backend/.env or frontend/.env.local.

# =============================================================================
# (B) BACKEND
# =============================================================================
# Local default shown. On Neon, use the POOLED connection string for the running
# app. For `python -m app.cli migrate` / `ingest`, use the DIRECT string,
# exported as DATABASE_URL just for that command.
DATABASE_URL=postgresql://darkroom:darkroom@localhost:5432/darkroom

# Comma separated list of allowed origins. In production, use the frontend
# address with no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-value
AUTH_TOKEN_TTL_MINUTES=480
DEMO_USERNAME=demo
DEMO_PASSWORD=darkroom-demo

# Render sets PORT automatically.
PORT=8000

# =============================================================================
# (C) FRONTEND (baked in at build time, rebuild after changing)
# =============================================================================
# In production, set this to the backend address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_USERNAME=demo
NEXT_PUBLIC_DEMO_PASSWORD=darkroom-demo
NEXT_PUBLIC_USE_MOCKS=false

# =============================================================================
# (D) OPTIONAL: Neon (reference only)
# =============================================================================
# Written by `neon deploy` into a local ignored file.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# (E) OPTIONAL: test scripts
# =============================================================================
# BASE_URL=http://localhost:8000
